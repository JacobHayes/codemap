#!/usr/bin/env -S bash -euo pipefail
# usage: scripts/review [REVSET]   review the changes in REVSET (default: everything on top of main)
# An independent reviewer (codex, read-only) reads the diff and the standards documents and
# prints findings. Needs the codex CLI. Findings are for the builder to fix or answer.
cd "$(dirname "$0")/.."
rev=${1:-main..@}
command -v codex >/dev/null || { echo "review: codex CLI not installed" >&2; exit 1; }
log=$(mktemp); trap 'rm -f "$log"' EXIT
docs="AGENTS.md INTENT.md ARCHITECTURE.md PRACTICES.md"
[ -f DESIGN.md ] && docs="$docs DESIGN.md"
{
  cat <<PROMPT
You are an independent code reviewer for the change below. Read these documents first; they are
the standards and they win over the code: $docs (read DESIGN.md only if the change touches the
UI or terminal output). Report only real problems, most severe first, each with file:line and a
concrete fix:
1. Correctness bugs: wrong behaviour, missed edge cases, broken invariants, nondeterminism.
2. Simplicity and scope violations: anything PRACTICES.md's Simplicity and Scope sections forbid,
   or work beyond INTENT.md's above-the-fold list.
3. Contradictions between the change and the documents, or documents the change leaves stale.
Do not comment on style rustfmt/clippy/eslint enforce. If there are no problems, say so.

The change is the jj revset $rev (output of jj diff --git):
PROMPT
  jj diff -r "$rev" --git
} | timeout 1800 codex exec -m gpt-6-luna -c model_reasoning_effort=high -s read-only \
    --ephemeral --color never - 2>"$log" || { cat "$log" >&2; exit 1; }
